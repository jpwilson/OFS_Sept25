{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/login", "destination": "/" },
    { "source": "/signup", "destination": "/" },
    { "source": "/signup/invited", "destination": "/" },
    { "source": "/auth/callback", "destination": "/" },
    { "source": "/demo-login", "destination": "/" },
    { "source": "/reset-password", "destination": "/" },
    { "source": "/checkout", "destination": "/" },
    { "source": "/privacy", "destination": "/" },
    { "source": "/terms", "destination": "/" },
    { "source": "/contact", "destination": "/" },
    { "source": "/blog", "destination": "/" },
    { "source": "/billing", "destination": "/" },
    { "source": "/feed", "destination": "/" },
    { "source": "/notifications", "destination": "/" },
    { "source": "/settings", "destination": "/" },
    { "source": "/settings/notifications", "destination": "/" },
    { "source": "/preferences", "destination": "/" },
    { "source": "/relationships", "destination": "/" },
    { "source": "/tags", "destination": "/" },
    { "source": "/my-feedback", "destination": "/" },
    { "source": "/family-tree", "destination": "/" },
    { "source": "/create", "destination": "/" },
    { "source": "/import", "destination": "/" },
    { "source": "/map", "destination": "/" },
    { "source": "/timeline", "destination": "/" },
    { "source": "/groups", "destination": "/" },
    { "source": "/event/:id", "destination": "/" },
    { "source": "/event/:id/edit", "destination": "/" },
    { "source": "/profile/:username", "destination": "/" },
    { "source": "/profile/:username/edit", "destination": "/" },
    { "source": "/share/:token", "destination": "/" },
    { "source": "/join/:token", "destination": "/" },
    { "source": "/tag-profile/:profileId", "destination": "/" },
    { "source": "/admin", "destination": "/" },
    { "source": "/admin/:path*", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ]
}
